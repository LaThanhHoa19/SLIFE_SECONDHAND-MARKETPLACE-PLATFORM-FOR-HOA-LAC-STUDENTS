<?xml version="1.0" encoding="UTF-8"?>
<RoutingRules>
  <!-- SPA (React Router): mọi đường dẫn không có object tương ứng → trả index.html -->
  <RoutingRule>
    <Condition>
      <HttpErrorCodeReturnedEquals>404</HttpErrorCodeReturnedEquals>
    </Condition>
    <Redirect>
      <ReplaceKeyWith>index.html</ReplaceKeyWith>
    </Redirect>
  </RoutingRule>
</RoutingRules>
