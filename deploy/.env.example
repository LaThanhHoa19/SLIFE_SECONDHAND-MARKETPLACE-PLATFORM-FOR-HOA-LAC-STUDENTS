# ===== MySQL =====
# Nếu set SPRING_DATASOURCE_URL tùy chỉnh, giữ: &useUnicode=true&characterEncoding=UTF-8 (tiếng Việt)
MYSQL_DATABASE=slife_db
MYSQL_USER=slife
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password

# ===== Spring =====
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRATION=3600000
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_USERNAME=replace
SPRING_MAIL_PASSWORD=replace

# Gửi mail qua Firebase Cloud Function (firebase/functions): đặt http + URL + secret (trùng MAIL_API_SECRET trên function)
# APP_MAIL_TRANSPORT=http
# APP_MAIL_HTTP_URL=https://asia-southeast1-<PROJECT>.cloudfunctions.net/sendSlifeMail
# APP_MAIL_HTTP_SECRET=your-shared-secret
GOOGLE_CLIENT_ID=replace-client-id
GOOGLE_CLIENT_SECRET=replace-client-secret

# ===== AWS S3 (upload ảnh — listing, avatar, chat, …) =====
# APP_STORAGE_MODE=s3
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Tiền tố object (mặc định media → key media/listings/...)
# AWS_S3_KEY_PREFIX=media
# Tuỳ chọn CDN / website URL (không dấu / cuối)
# AWS_S3_PUBLIC_BASE_URL=

# ===== Frontend build =====
VITE_API_BASE_URL=/api
# Link "Mở SLIFE" trong email welcome = FRONTEND_URL + /feed
# FRONTEND_URL=https://your-domain.com

