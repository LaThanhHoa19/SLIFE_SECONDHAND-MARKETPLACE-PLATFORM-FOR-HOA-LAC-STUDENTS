VITE_API_BASE_URL=http://localhost:8080
# Khi build cho server thật (npm run build): tạo .env.production — xem .env.production trong repo hoặc copy từ đây
# VITE_API_BASE_URL=https://api.example.com
# VITE_WS_URL=https://api.example.com/chat
VITE_GOOGLE_CLIENT_ID=your_google_client_id
# Tuỳ chọn: key bản đồ Vietmap (nếu không set, FE sẽ gọi GET /api/geo/client-config — cần BE dev có vietmap.tileKey)
# VITE_VIETMAP_TILE_KEY=
